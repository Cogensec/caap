{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogensec.com/schemas/caap/evidence-bundle-1.0.schema.json",
  "title": "CAAP evidence bundle submission",
  "description": "The submission.json record inside a caap-evidence.zip produced by `caap attest create`. It describes one CAAP result, names every evidence file in the bundle with its SHA-256, and carries its own canonical hash so a registry can verify it without trusting the submitter.",
  "type": "object",
  "required": [
    "schema_version", "bundle_kind", "generated_at", "assurance_tier", "labels",
    "taxonomy_version", "caap_benchmark_version", "subject", "evaluation", "scorecard",
    "integrity", "claim_boundary", "claim_rule", "badge", "files", "submission_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "bundle_kind": {"const": "caap-evidence-bundle"},
    "generated_at": {"type": "string"},
    "assurance_tier": {"enum": ["agent_native", "observed_reference"]},
    "labels": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "taxonomy_version": {"type": "string", "minLength": 1},
    "caap_benchmark_version": {"type": "string", "minLength": 1},
    "subject": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]}
      }
    },
    "evaluation": {
      "type": "object",
      "required": ["kind", "case_count"],
      "properties": {
        "kind": {"enum": ["agent_self_assessment", "observed_reference"]},
        "case_count": {"type": "integer", "minimum": 1},
        "profile": {"type": "object"},
        "scope": {"enum": ["applicable", "full"]},
        "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "adapters": {"type": "array", "items": {"type": "string"}}
      }
    },
    "scorecard": {
      "type": "object",
      "required": ["total", "passed", "failed", "inconclusive", "not_applicable", "security_score", "coverage_percent"],
      "properties": {
        "total": {"type": "integer"},
        "passed": {"type": "integer"},
        "failed": {"type": "integer"},
        "inconclusive": {"type": "integer"},
        "not_applicable": {"type": "integer"},
        "security_score": {"type": ["number", "null"]},
        "severity_weighted_score": {"type": ["number", "null"]},
        "coverage_percent": {"type": "number"}
      }
    },
    "layers": {"type": ["object", "null"]},
    "integrity": {"type": "object"},
    "authorization_statement": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "claim_boundary": {"type": "string", "minLength": 1},
    "claim_rule": {"type": "string", "minLength": 1},
    "badge": {
      "type": "object",
      "required": ["label", "message", "tier"],
      "properties": {
        "label": {"type": "string"},
        "message": {"type": "string"},
        "tier": {"type": "string"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "pattern": "^evidence/"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    },
    "submission_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
