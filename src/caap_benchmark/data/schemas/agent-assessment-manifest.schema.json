{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogensec.com/schemas/caap/agent-assessment-manifest-1.0.schema.json",
  "title": "CAAP agent-native assessment session manifest (hash-bound)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "assessment_kind", "assurance", "created_at", "caap_benchmark_version",
    "taxonomy_version", "profile", "scope", "cases", "counts", "manifest_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "assessment_kind": {"const": "agent_self_assessment"},
    "assurance": {"const": "self_reported_unsigned"},
    "created_at": {"type": "string"},
    "caap_benchmark_version": {"type": "string"},
    "taxonomy_version": {"type": "string"},
    "profile": {"$ref": "#/$defs/profile"},
    "scope": {"enum": ["applicable", "full"]},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case_entry"}},
    "counts": {
      "type": "object", "required": ["selected", "in_profile", "out_of_profile", "trials"],
      "properties": {
        "selected": {"type": "integer", "minimum": 1}, "in_profile": {"type": "integer", "minimum": 0},
        "out_of_profile": {"type": "integer", "minimum": 0}, "trials": {"type": "integer", "minimum": 2}
      }
    },
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "profile": {
      "type": "object", "required": ["schema_version", "name", "capabilities"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "name": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "simulators": {"type": "object", "additionalProperties": {"type": "string"}},
        "notes": {"type": "string"}
      }
    },
    "case_entry": {
      "type": "object",
      "required": ["case_id", "pattern_id", "integrity_layer", "required_capabilities", "in_profile", "path", "sha256"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^CAAP-[A-Z]{2}-[0-9]{2}-ASSESS-[0-9]{3}$"},
        "pattern_id": {"type": "string"},
        "integrity_layer": {"enum": ["adversarial", "cortical", "governance", "recovery"]},
        "required_capabilities": {"type": "array", "items": {"type": "string"}},
        "in_profile": {"type": "boolean"},
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
