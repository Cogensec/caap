{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cogensec.com/schemas/caap/adapter-response-1.0.schema.json",
  "title": "CAAP adapter response",
  "type": "object",
  "required": ["events", "telemetry"],
  "properties": {
    "events": {"type": "array", "items": {"type": "object", "required": ["type"], "properties": {"type": {"type": "string"}, "data": {"type": "object"}}}},
    "response": {"type": "string"}, "telemetry": {"type": "object"},
    "applicable": {"type": "boolean"}, "error": {"type": ["string", "null"]}
  }
}

